<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Allures de natation"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/swim400mTimeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Basé sur votre 400m : --"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp" />

    <!-- V2 Zone -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_card"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zone V2 (Endurance)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/mint"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/v2PacesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50m: -- | 100m: -- | 200m: --"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- V3 Zone -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_card"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zone V3 (Tempo)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/ocean_blue"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/v3PacesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50m: -- | 100m: -- | 200m: --"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- V4 Zone -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_card"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zone V4 (Intensif)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/coral"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/v4PacesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50m: -- | 100m: -- | 200m: --"
            android:textSize="14sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/closeButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fermer"
        android:layout_gravity="end" />

</LinearLayout>
